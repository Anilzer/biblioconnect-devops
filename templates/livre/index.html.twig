{% extends 'base.html.twig' %}

{% block title %}Nos livres{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4"><b>Liste des livres</b></h1>

    {# Afficher les messages flash #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    <form method="get" action="{{ path('search_livres') }}" class="mb-4">
        <div class="input-group">
            <input type="text" name="q" class="form-control" placeholder="Rechercher par titre, auteur, thème...">
            <button type="submit" class="btn btn-primary">Rechercher</button>
        </div>
    </form>

    <div class="row">
    {% for livre in livres %}
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body d-flex flex-column justify-content-between">
                    <h2 class="card-title mb-3">
                        <i class="bi bi-book"></i> <strong>{{ livre.title }}</strong>
                    </h2>
                    <p class="card-text">
                        Par {{ livre.auteur.firstname }} {{ livre.auteur.name }}<br>
                    </p>
                    <div class="mt-4">
                        <a href="{{ path('livre_details', {'id': livre.id}) }}" class="btn btn-warning me-2">Détails</a>
                        {# Vérifier si le livre a des réservations avec un statut "en_attente" ou "reserve" #}
                        {% set livre_reserve = false %}
                        {% for reservation in livre.reservations %}
                            {% if reservation.statut in ['en_attente', 'reserve'] %}
                                {% set livre_reserve = true %}
                            {% endif %}
                        {% endfor %}

                        {% if livre_reserve %}
                            <span class="btn btn-secondary disabled">Livre déjà réservé</span>
                        {% else %}
                            <a href="{{ path('livre_reserver', {'id': livre.id}) }}" class="btn btn-success">Réserver</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <p class="text-center">Aucun livre disponible.</p>
    {% endfor %}
</div>

</div>
{% endblock %}

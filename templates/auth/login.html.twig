{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <!-- Card pour la connexion avec un shadow -->
                <div class="card shadow-lg">
                    <div class="card-header text-center">
                        <h3>Connexion 30 Octobre 2026 Soutenance</h3>
                    </div>
                    <div class="card-body">
                        <!-- Affichage des messages flash -->
                        {% for label, messages in app.flashes %}
                            <div class="alert alert-{{ label }}">
                                {% for message in messages %}
                                    <p>{{ message }}</p>
                                {% endfor %}
                            </div>
                        {% endfor %}

                        <!-- Formulaire de connexion -->
                        <form action="{{ path('app_login') }}" method="post">
                            <div class="mb-3">
                                <label for="username" class="form-label">Email</label>
                                <input  placeholder="votre adresse mail" type="email" id="username" name="_username" class="form-control" required autofocus>
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label">Mot de passe</label>
                                <input placeholder="votre mot de passe"  type="password" id="password" name="_password" class="form-control" required>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success">Se connecter</button>
                            </div>
                        </form>

                         {% if error %}
                            <div class="alert alert-danger mt-3">
                                    <p>Erreur de connexion : {{ error.messageKey|trans(error.messageData, 'security') }}</p>
                            </div>
                         {% endif %}


                        <p class="mt-3 text-center">
                            <a href="{{ path('app_register') }}">Pas encore inscrit ? Créez un compte</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

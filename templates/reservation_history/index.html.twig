{% extends 'base.html.twig' %}

{% block title %}Mon historique de réservations{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Historique de mes réservations</h1>

    {% if reservations is empty %}
        <div class="alert alert-info">
            Vous n'avez effectué aucune réservation pour le moment.
        </div>
    {% else %}
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Titre du livre</th>
                            <th>Date de réservation</th>
                            <th>Statut</th>
                            <th>Nom de l'utilisateur</th> 
                        </tr>
                    </thead>
                    <tbody>
                        {% for reservation in reservations %}
                            <tr>
                                <td>{{ reservation.livre.title }}</td>
                                <td>{{ reservation.dateReservation|date('d/m/Y') }}</td>
                                <td>{{ reservation.statut }}</td>
                                 <td>{{ reservation.user.firstname }} {{ reservation.user.name }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    <a href="{{ path('admin_livres') }}" class="btn btn-secondary mt-4">← Retour au menu</a>
</div>
{% endblock %}
